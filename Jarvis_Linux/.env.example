# Copy to .env (project folder) or ~/.config/jarvis/.env. Real environment variables win.
# Any setting can be overridden: JARVIS_<SECTION>__<KEY>  (double underscore = nesting)

# JARVIS_CONFIG=~/.config/jarvis/config.json
# JARVIS_ASSISTANT_NAME=Jarvis
# JARVIS_VOICE__OUTPUT_ENABLED=true
# JARVIS_VOICE__INPUT_ENABLED=false
# JARVIS_VOICE__STT_BACKEND=vosk
# JARVIS_VOICE__VOSK_MODEL_PATH=~/models/vosk-model-small-en-us-0.15
# JARVIS_WEB__SEARCH_ENGINE=google
# JARVIS_FILES__SEARCH_ROOTS=~/Documents,~/Downloads
# JARVIS_LOGGING__CONSOLE_LEVEL=INFO
