# Copy this file to .env and fill in whichever providers you use.
# .env is already git-ignored. Nothing here is read unless python-dotenv
# is installed (pip install python-dotenv) — otherwise just export these
# as real environment variables instead.

# --- AI Gateway: fallback order (comma-separated, no spaces needed) ---
# Default if unset: openrouter,gemini,groq,ollama_cloud,ollama_local
# AI_PROVIDER_ORDER=openrouter,gemini,groq,ollama_cloud,ollama_local
# AI_REQUEST_TIMEOUT=30
# AI_MAX_RETRIES=1

# --- OpenRouter ---
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct

# --- Google Gemini ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini/gemini-2.0-flash

# --- Groq ---
GROQ_API_KEY=
# GROQ_MODEL=groq/llama-3.3-70b-versatile

# --- Ollama Cloud (https://ollama.com) ---
OLLAMA_API_KEY=
# OLLAMA_CLOUD_MODEL=gpt-oss:20b
# OLLAMA_CLOUD_API_BASE=https://ollama.com

# --- Local Ollama (last-resort fallback, Gemma 3 only, no key needed) ---
# OLLAMA_LOCAL_API_BASE=http://localhost:11434

# --- Optional: FreeLLMAPI / any other OpenAI-compatible endpoint ---
# Only used if you add "freellmapi" to AI_PROVIDER_ORDER above.
# FREELLMAPI_API_BASE=
# FREELLMAPI_API_KEY=
# FREELLMAPI_MODEL=gpt-4o-mini

